# Copy to .env and fill in. All keys are OPTIONAL:
# the project runs fully offline on a local feature store if none are set.

# --- Hopsworks (serverless feature store + model registry) ---
# Get a free key at https://app.hopsworks.ai  ->  Account Settings -> API Keys
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=

# --- AQICN (live official AQI) ---
# Free token at https://aqicn.org/data-platform/token/
AQICN_TOKEN=

# --- OpenWeather (alternate weather/pollutant provider) ---
# Free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
